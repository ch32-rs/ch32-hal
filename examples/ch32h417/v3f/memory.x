/*
 * CH32H417QEU6 (QingKe V3F / boot core) linker memory map.
 *
 * Hart 0 has no usable instruction cache, so where the code runs decides its
 * speed. RM §1.2.1:
 *
 * - Code FLASH is *non*-zero-wait, equivalent to about 25 MHz (DBMODE=1) or
 *   12.5 MHz (DBMODE=0). Measured cost: roughly 38 HCLK cycles per
 *   instruction at 100 MHz, i.e. ~2.6 MIPS.
 * - The 512 KB shared block is zero-wait for both cores. It can be used as
 *   the RISC-V3F code *and* data area, and the CSDK's `Link_v3f.ld` does
 *   exactly that (`RAM_CODE = 0x20100000`).
 * - Hart 1's ITCM (code) and DTCM (data) cost hart 0 two HCLK waits each,
 *   so they are the slow choice for the boot core.
 *
 * So the boot core runs entirely out of the shared block: `link.x` copies
 * `.highcode` (all of `.text`/`.rodata`) from flash at startup, and `.data`/
 * `.bss`/the stack already live here. Flash holds only the load image, and
 * a V3F image that outgrows the 64 KB slot is a link error rather than a
 * silent overwrite of the V5F image.
 *
 *   0x20100000 + 448K  zero-wait code, data and bss (V3F)
 *   0x20170000 +  32K  zero-wait stack
 *   0x20178000 +  32K  cross-core mailbox, the same address in both maps
 *
 * The V5F image keeps its own flash at 0x00010000 and DTCM at 0x200C0200.
 *
 * This also overrides the `memory.x` generated by `ch32-metapac/memory-x`:
 * that script names the H417 RAM regions ITCM/DTCM/SRAM_SHARED but never
 * declares a region literally called `RAM`, which `qingke-rt`'s `link.x`
 * needs for `.highcode`, `.data`, `.bss` and `.uninit`.
 */
MEMORY
{
    CODE   (rx)  : ORIGIN = 0x00000000, LENGTH =  64K  /* USR boot alias; V3F load slot */
    USR    (rwx) : ORIGIN = 0x08000000, LENGTH =  64K  /* the same window through 0x08000000 */
    SYS    (rwx) : ORIGIN = 0x1FFF0000, LENGTH =   56K
    VND    (r)   : ORIGIN = 0x1FFFF700, LENGTH =   256
    OPT    (rw)  : ORIGIN = 0x1FFFF800, LENGTH =   256
    RAM    (rwx) : ORIGIN = 0x20100000, LENGTH = 448K  /* zero-wait code/data/bss */
    STACK  (rwx) : ORIGIN = 0x20170000, LENGTH =  32K  /* zero-wait stack */
    ITCM   (rwx) : ORIGIN = 0x200A0000, LENGTH =  128K /* hart 1 code; 2 waits for hart 0 */
    SRAM_SHARED (rwx) : ORIGIN = 0x20178000, LENGTH = 32K /* cross-core mailbox */
}

REGION_ALIAS("FLASH", CODE);
REGION_ALIAS("REGION_TEXT", CODE);
REGION_ALIAS("REGION_RODATA", CODE);
REGION_ALIAS("REGION_DATA", RAM);
REGION_ALIAS("REGION_BSS", RAM);
REGION_ALIAS("REGION_HEAP", RAM);
REGION_ALIAS("REGION_STACK", STACK);
